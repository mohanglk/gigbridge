# Copy to backend/.env and set a strong local password before starting Compose.
# Compose loads these POSTGRES_* values into PostgreSQL; the backend accepts
# the same values as its database credentials.
POSTGRES_USER=gigbridge
POSTGRES_PASSWORD=
POSTGRES_DB=gigbridge

# Optional full connection string override. Leave blank to use the values above.
# Compose sets DATABASE_HOST=db; local runs default to localhost.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Generate 32 bytes of cryptographically random key material locally:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the output as JWT_SECRET. Runtime validates URL-safe Base64 encoding and
# minimum decoded size; operators must use the generation command above because
# string length cannot prove entropy. Never use a placeholder or commit the value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=gigbridge-api
JWT_AUDIENCE=gigbridge-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
AUTH_COOKIE_SAMESITE=lax

# Only list reverse proxies that are trusted to sanitize/append X-Forwarded-For.
TRUSTED_PROXY_IPS=[]

# Separate random key used to HMAC-hash rate-limit identifiers in Redis:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_RATE_LIMIT_HMAC_SECRET=

# Starter policies; tune these values using deployment traffic and abuse data.
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_IP_WINDOW_SECONDS=3600
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_REGISTER_ACCOUNT_WINDOW_SECONDS=3600
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=900

AWS_S3_BUCKET=gigbridge-media
AWS_REGION=ap-south-1
