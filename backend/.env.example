# Copy to backend/.env and set a strong local password before starting Compose.
# Compose loads these POSTGRES_* values into PostgreSQL; the backend accepts
# the same values as its database credentials.
POSTGRES_USER=gigbridge
POSTGRES_PASSWORD=
POSTGRES_DB=gigbridge

# Optional full connection string override. Leave blank to use the values above.
# Compose sets DATABASE_HOST=db; local runs default to localhost.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Generate 32 bytes of cryptographically random key material locally:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the output as JWT_SECRET. Runtime validates URL-safe Base64 encoding and
# minimum decoded size; operators must use the generation command above because
# string length cannot prove entropy. Never use a placeholder or commit the value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=gigbridge-api
JWT_AUDIENCE=gigbridge-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15

AWS_S3_BUCKET=gigbridge-media
AWS_REGION=ap-south-1
