# Copy to backend/.env and set a strong local password before starting Compose.
# Compose loads these POSTGRES_* values into PostgreSQL; the backend accepts
# the same values as its database credentials.
POSTGRES_USER=gigbridge
POSTGRES_PASSWORD=
POSTGRES_DB=gigbridge

# Optional full connection string override. Leave blank to use the values above.
# Compose sets DATABASE_HOST=db; local runs default to localhost.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Generate a unique secret for any future token signing use. Leave unset/blank
# until that functionality is enabled.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AWS_S3_BUCKET=gigbridge-media
AWS_REGION=ap-south-1
